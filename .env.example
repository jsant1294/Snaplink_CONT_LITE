# OpenRouter (free models only — enforced by lib/ai/model-guard.ts)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Optional override; MUST end in ":free" or the model guard will reject it
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Used for OpenRouter attribution headers
APP_URL=http://localhost:3000

# Operator master PIN (unlocks the operator console + every contractor scope)
OPERATOR_PIN=777777

# Production database (Neon Postgres connection string). When set, the app
# runs on Postgres via Drizzle. When unset, local JSON files (.data/) are used.
# DATABASE_URL=postgres://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: Vercel Blob for photo storage (recommended in production)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Optional: instant SMS alert to the contractor when a new lead comes in.
# All three required to send; unset = feature silently no-ops.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+15555550100

# SnapLink Real Estate production integrations (all fail closed when selected
# provider requirements are incomplete; never place real values in this file).
REAL_ESTATE_EMAIL_PROVIDER=disabled
REAL_ESTATE_SMS_PROVIDER=disabled
REAL_ESTATE_PROVIDER_TEST_MODE=true
# REAL_ESTATE_EMAIL_FROM=real-estate@example.com
# REAL_ESTATE_EMAIL_REPLY_TO=reply@example.com
# REAL_ESTATE_SMS_FROM=+15555550100
# RESEND_API_KEY=re_xxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxx
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_WEBHOOK_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----..."
# TWILIO_MESSAGING_SERVICE_SID=MGxxxx
# TWILIO_WEBHOOK_AUTH_TOKEN=xxxx
# GOOGLE_CALENDAR_CLIENT_ID=xxxx
# GOOGLE_CALENDAR_CLIENT_SECRET=xxxx
# GOOGLE_CALENDAR_REDIRECT_URI=https://example.com/api/real-estate/calendar/google/callback
# MICROSOFT_CALENDAR_CLIENT_ID=xxxx
# MICROSOFT_CALENDAR_CLIENT_SECRET=xxxx
# MICROSOFT_CALENDAR_TENANT=common
# MICROSOFT_CALENDAR_REDIRECT_URI=https://example.com/api/real-estate/calendar/microsoft/callback
# REAL_ESTATE_TOKEN_ENCRYPTION_KEY=minimum-32-character-random-secret
# REAL_ESTATE_JOB_PROCESSOR_SECRET=minimum-32-character-random-secret
# REAL_ESTATE_WEBHOOK_BASE_URL=https://example.com
# REAL_ESTATE_APP_BASE_URL=https://example.com

# SnapLink Real Estate AI (server-only, disabled by default).
REAL_ESTATE_AI_ENABLED=false
REAL_ESTATE_AI_PROVIDER=disabled
REAL_ESTATE_AI_TEST_MODE=true
REAL_ESTATE_AI_DEFAULT_MODEL=disabled
REAL_ESTATE_AI_FAST_MODEL=disabled
REAL_ESTATE_AI_STRUCTURED_MODEL=disabled
REAL_ESTATE_AI_EMBEDDING_MODEL=disabled
REAL_ESTATE_AI_MAX_INPUT_TOKENS=12000
REAL_ESTATE_AI_MAX_OUTPUT_TOKENS=1800
REAL_ESTATE_AI_MONTHLY_TENANT_LIMIT=500
REAL_ESTATE_AI_DAILY_USER_LIMIT=25
REAL_ESTATE_AI_REDACTION_ENABLED=true
REAL_ESTATE_AI_LOG_CONTENT=false

# Phase 9 public API. Use a distinct, random server-only value in production.
REAL_ESTATE_API_CURSOR_SECRET=
REAL_ESTATE_AI_TIMEOUT_MS=30000
REAL_ESTATE_AI_MAX_CONCURRENT=3
# OPENAI_API_KEY=sk-example
# ANTHROPIC_API_KEY=sk-ant-example
# GROQ_API_KEY=gsk_example

# Lucio (Southline homepage chat widget). Disabled by default — the widget
# still works (guided prompts, search) but replies with a static fallback
# message instead of a real LLM response until this is set. Groq's free tier
# is convenient for local testing; swap to openai/anthropic for production.
# LUCIO_AI_ENABLED=true
# LUCIO_AI_PROVIDER=groq
# LUCIO_AI_MODEL=llama-3.3-70b-versatile

# Stripe Connect (contractor self-service Invoices). Disabled by default —
# also requires a real Postgres backend (DATABASE_URL above); the Invoices
# tab shows "Connect Stripe to enable Invoices" until STRIPE_SECRET_KEY is set.
# STRIPE_SECRET_KEY=sk_live_xxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Stripe Connect application/client id, used for each contractor's Express
# onboarding link.
# STRIPE_CONNECT_CLIENT_ID=ca_xxxx
